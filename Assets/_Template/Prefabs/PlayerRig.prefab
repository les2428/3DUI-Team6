  canvas: {fileID: 1614678432994454512}
  helpPanel: {fileID: 2943030635929075431}
  enterVRButton: {fileID: 5068597026641056722}
  titleText: {fileID: 592789125927810486}
  toggleHelpKey: 104
  spaceTitle: My WebXR Space
  spaceTitleKo: "\uB098\uC758 WebXR \uACF5\uAC04"
  controlsText: {fileID: 6562381132536174693}
  controlsEn: 'WASD / arrows : move      Shift : run

    Drag (empty space) or right-drag
    : look

    Q / E : turn

    Click : select / press      Hold + move : grab

    Scroll
    while holding : push / pull

    H : hide this help'
  controlsKo: "WASD / \uBC29\uD5A5\uD0A4 : \uC774\uB3D9      Shift : \uB2EC\uB9AC\uAE30\n\uBE48
    \uACF3 \uB4DC\uB798\uADF8 \uB610\uB294 \uC624\uB978\uCABD \uBC84\uD2BC \uB4DC\uB798\uADF8
    : \uC2DC\uC810\nQ / E : \uD68C\uC804\n\uD074\uB9AD : \uC120\uD0DD / \uB204\uB974\uAE30     
    \uB204\uB978 \uCC44 \uC774\uB3D9 : \uC7A1\uAE30\n\uC7A1\uC740 \uCC44 \uD720 :
    \uBC00\uACE0 \uB2F9\uAE30\uAE30\nH : \uB3C4\uC6C0\uB9D0 \uC228\uAE30\uAE30"
  toggleCreditsKey: 99
